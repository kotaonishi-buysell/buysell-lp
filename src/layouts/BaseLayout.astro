---
/* Layout of the Home Appraisal LPs (Downsizing and the three to come): shared stylesheets plus the document. */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/form-support.css';
import type { LandingPage } from '../content/types';
import Document from './Document.astro';

interface Props {
  lp: LandingPage;
}

const { lp } = Astro.props;
const hero = lp.sections.find((section) => section.type === 'hero');
---

<Document
  slug={lp.slug}
  meta={{ ...lp.meta, ogImageAlt: hero?.type === 'hero' ? hero.imageAlt : undefined }}
  bodyAttrs={{ 'data-scene': lp.scene }}
  preloadFonts={['newsreader-latin-opsz-normal.woff2', 'instrument-sans-latin-400-normal.woff2']}
>
  <slot />
</Document>

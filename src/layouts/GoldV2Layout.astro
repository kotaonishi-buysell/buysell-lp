---
/*
 * Layout of the second Gold LP (/gold-v2). Loads tokens.css and form-support.css (the shared form needs them) and
 * gold-v2.css, but not base.css, silver.css or gold.css: gold-v2.css has its own resets and global element rules, which
 * must not meet theirs. Keep gold-v2.css last: it sets the form skin.
 */
import '../styles/tokens.css';
import '../styles/form-support.css';
import '../styles/gold-v2.css';
import type { CustomLandingPage } from '../content/types';
import Document from './Document.astro';

interface Props {
  page: CustomLandingPage;
}

const { page } = Astro.props;
---

<Document
  slug={page.slug}
  meta={page.meta}
  bodyAttrs={{ 'data-lp': page.slug }}
  preloadFonts={['instrument-serif-400-normal.woff2', 'open-sans-variable.woff2']}
>
  <slot />
</Document>

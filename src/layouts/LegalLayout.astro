---
/*
 * Layout of the shared legal pages (privacy, terms, do not sell). One look for every LP, so the page
 * is the same wherever the link was clicked. It loads only fonts.css and legal.css: no LP stylesheet,
 * no analytics and no scripts.
 */
import '../styles/fonts.css';
import '../styles/legal.css';
import { site } from '../content/site';
import { legalCopy, legalPages } from '../content/legal';
import { fill, plain } from '../lib/text';
import BrandLogo from '../components/BrandLogo.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
}

const { slug, title, description } = Astro.props;
const company = plain(site.company.name);
const pageTitle = `${title} | ${site.brand.name}`;
const canonical = new URL(`/${slug}`, Astro.site);
const pages = legalPages.map((page) => ({ slug: page.slug, label: page.title, href: `/${page.slug}` }));
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={fill(plain(description), { company, brand: site.brand.name })} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-page="legal">
    <a class="skip-link" href="#main">{site.ui.skipLink}</a>
    <header class="lg-header">
      <div class="lg-wrap lg-header__inner">
        <a class="lg-brand" href="/" aria-label={`${site.brand.name} home`}><BrandLogo class="lg-logo" decorative /></a>
        <nav aria-label={legalCopy.navLabel}>
          <ul class="lg-nav" role="list">
            {
              pages.map((page) => (
                <li>
                  <a href={page.href} aria-current={page.slug === slug ? 'page' : undefined}>
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="lg-wrap">
      <slot />
    </main>
    <footer class="lg-footer">
      <div class="lg-wrap">
        <p>{fill(site.ui.footer.copyright, { year: new Date().getFullYear(), company })}</p>
      </div>
    </footer>
  </body>
</html>

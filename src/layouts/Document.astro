---
/*
 * The HTML document shared by every LP: head (meta, OG, LocalBusiness data,
 * GTM), skip link and the shared browser scripts. It loads no stylesheet; the
 * layout that wraps it (BaseLayout, SilverLayout) brings its own.
 */
import { site } from '../content/site';
import { plain } from '../lib/text';

interface Props {
  slug: string;
  meta: { title: string; description: string; ogImage: string; ogImageAlt?: string };
  /** Attributes for <body>, e.g. data-scene. */
  bodyAttrs?: Record<string, string>;
  /** Font files under public/fonts/ used above the fold. */
  preloadFonts: string[];
}

const { slug, meta, bodyAttrs = {}, preloadFonts } = Astro.props;
const title = plain(meta.title);
const description = plain(meta.description);
const canonical = new URL(`/${slug}`, Astro.site);
const ogImage = new URL(meta.ogImage, Astro.site);
const gtmId = site.analytics.gtmId;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: plain(site.company.name),
  url: canonical.href,
  telephone: site.phone.e164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: plain(site.company.address),
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  areaServed: plain(site.serviceArea.summary),
  openingHours: plain(site.company.hours),
  identifier: plain(`${site.company.registration.label} ${site.company.registration.value}`),
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');

const gtmScript = gtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});`
  : '';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:," />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {meta.ogImageAlt && <meta property="og:image:alt" content={meta.ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />

    {preloadFonts.map((font) => <link rel="preload" href={`/fonts/${font}`} as="font" type="font/woff2" crossorigin />)}

    <script type="application/ld+json" set:html={structuredDataJson} />
    {gtmId && <script is:inline set:html={gtmScript} />}
  </head>
  <body {...bodyAttrs}>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a class="skip-link" href="#main">{site.ui.skipLink}</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

---
/*
 * Silver LP (/silver): "Silver appraisals, right at your kitchen table".
 * Markup and styling come from the Codex mock-up (src/styles/silver.css); copy that is
 * shared with the LP machinery is in src/content/lps/silver.ts and src/content/site.ts.
 * Everything that is a call or a request goes through the shared pieces:
 *   - phone buttons are tel: links with data-cta (tracked by scripts/cta.ts)
 *   - booking buttons carry data-booking and open the shared contact form (ContactForm) in the dialog
 *   - the service-area ZIP box is the shared ZipCheck
 *   - the mock-up's own animation and carousel code is in src/scripts/silver.ts
 */
import SilverLayout from '../layouts/SilverLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import ZipCheck from '../components/ZipCheck.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { silver, silverFaq } from '../content/lps/silver';
import { site } from '../content/site';
import { company } from '../content/company';
import { paymentNote } from '../content/payment-note';
import { fill, plain, rich } from '../lib/text';

const telHref = `tel:${site.phone.e164}`;
const hoursLine = site.company.hours ? rich(fill(site.phone.hoursLine, { hours: site.company.hours })) : null;
const year = new Date().getFullYear();

// Mock-up banner. Set to false at launch, together with the "Design preview" note in the footer.
const showPreviewStrip = true;
---

<SilverLayout page={silver}>
  {
    showPreviewStrip && (
      <div class="preview-strip">
        DESIGN PREVIEW <span>·</span> Contact details, credentials &amp; offers subject to confirmation
      </div>
    )
  }
  <header class="header wrap">
<a class="brand" href="#" aria-label={`${company.brand} home`}><BrandLogo class="brand-logo" decorative /><span>SILVER SPECIALISTS · TEXAS</span></a>
<nav class="desktop-nav" aria-label="Main navigation"><a href="#silver">What we buy</a><a href="#how">How it works</a><a href="#questions">Your questions</a></nav>
<div class="header-contact">{hoursLine && <p class="call-hours" set:html={hoursLine} />}<a class="phone-text" href={telHref} data-cta="header" data-cta-method="phone">{site.phone.callPrefix} <span data-phone-number>{site.phone.display}</span></a><div><span>{site.company.registration.label} <Fragment set:html={rich(site.company.registration.value)} /></span><button class="text-link" type="button" data-booking data-cta="header" data-cta-method="form">Book online <span aria-hidden="true">↗</span></button></div></div>
</header>
<main id="main">
<section class="hero wrap" aria-labelledby="hero-title" data-hero>
<div class="hero-copy"><p class="eyebrow"><span class="short-rule"></span> YOUR SILVER. YOUR HOME. YOUR CHOICE.</p><h1 id="hero-title"><span>Keep the silver at home.</span><em>We'll handle the rest.</em></h1><h2 class="hero-sub">Free silver appraisals by house call,<br class="desktop-only"> right at your kitchen table.</h2><div class="hero-actions"><a class="button" href={telHref} data-cta="hero" data-cta-method="phone">{site.phone.callPrefix} <span data-phone-number>{site.phone.display}</span> <span aria-hidden="true">↗</span></a><button class="text-link" type="button" data-booking data-cta="hero" data-cta-method="form">Book online <span aria-hidden="true">↗</span></button></div><ul class="hero-chips"><li>Free appraisal</li><li>No obligation</li><li>We come to you</li><li>Paid next day</li></ul></div>
<figure class="hero-photo"><img src="/images/silver/house-call.webp" alt="Illustrative scene of a silver appraiser and homeowner exploring an open flatware chest at a kitchen table" width="1400" height="933" fetchpriority="high"><figcaption><span>GOOD THINGS DESERVE A NEXT CHAPTER.</span><span class="photo-caption">An appraisal, at your pace.</span><span class="image-note">Illustrative photography</span></figcaption></figure>
</section>
<section class="trust wrap" aria-label="Service assurances"><div><span class="trust-label">A little peace of mind.</span><p>Registered with the Texas OCCC<br><small>Reg. No. <Fragment set:html={rich(site.company.registration.value)} /></small></p></div></section>
<section id="silver" class="buy-section section wrap" data-folio="01">
<div class="section-top"><p class="eyebrow">01 / THE SILVER YOU HAVE</p><p class="section-aside">The special-occasion set.<br>The drawer you haven't opened in years.</p></div>
<div class="category-heading"><h2>What can you sell?</h2><p>More than you might think.<br>And it doesn't have to be perfect.</p></div>
<div class="category-carousel" role="region" aria-roledescription="carousel" aria-label="Silver categories">
<div class="category-viewport" tabindex="0" aria-label="Explore six silver categories. Swipe or use the arrow keys to scroll.">
<div class="category-track"><ul class="category-group">
<li class="category-item"><span class="category-image category-flatware" role="img" aria-label="Sterling silver fork, spoon and knife"></span><h3>Flatware sets</h3></li>
<li class="category-item"><span class="category-image category-tea" role="img" aria-label="Silver teapot and cream pitcher"></span><h3>Tea &amp; coffee<br>services</h3></li>
<li class="category-item"><span class="category-image category-trays" role="img" aria-label="Silver tray and candlesticks"></span><h3>Trays &amp;<br>candlesticks</h3></li>
<li class="category-item"><span class="category-image category-coins" role="img" aria-label="A collection of silver coins"></span><h3>Silver coins</h3></li>
<li class="category-item"><span class="category-image category-jewelry" role="img" aria-label="Silver bracelet and ring"></span><h3>Silver jewelry</h3></li>
<li class="category-item"><span class="category-image category-tarnished" role="img" aria-label="Tarnished silver spoon and dented cup"></span><h3>Tarnished or<br>damaged pieces</h3></li>
</ul></div></div>
<div class="category-controls"><p>Any condition. Not sure if it's real silver? That's okay.</p><button class="category-motion" type="button" aria-label="Pause automatic scrolling"><span class="motion-symbol" aria-hidden="true">Ⅱ</span><span class="motion-label">Pause</span></button></div>
</div>
<div class="also-buy"><span class="serif">And more than silver.</span><div><strong>We also buy jewelry, gold coins and necklaces, designer handbags, watches and cameras.</strong><p>Not sure whether something qualifies? Show us. We're happy to take a look.</p></div></div>
<aside class="polish"><span class="serif">A small favor:</span><div><strong>Please don't polish your silver.</strong><p>Polishing can remove value. We assess your pieces just as they are.</p></div><span class="polish-star" aria-hidden="true">✳</span></aside>
</section>
<section id="how" class="how section" data-folio="02"><div class="wrap"><div class="section-top"><p class="eyebrow">02 / SIMPLE, FROM START TO FINISH</p><button class="text-link" type="button" data-booking data-cta="mid" data-cta-method="form">Find a time that suits you <span aria-hidden="true">↗</span></button></div><h2>How a house call works.</h2><div class="steps"><article class="reveal"><div class="step-stage"><span class="step-number" aria-hidden="true">01</span><span class="step-art step-art-book" role="img" aria-label="A homeowner comfortably arranging a visit by phone"></span></div><div class="step-copy"><span class="step-kicker">STEP ONE</span><h3>Make a little time.</h3><p>Call or book online. Pick a time that suits you. Leave your silver exactly where it is.</p></div></article><article class="reveal"><div class="step-stage"><span class="step-number" aria-hidden="true">02</span><span class="step-art step-art-appraise" role="img" aria-label="An appraiser examining silver with the homeowner at the kitchen table"></span></div><div class="step-copy"><span class="step-kicker">STEP TWO</span><h3>We'll take a look.</h3><p>We appraise at your home, right in front of you. We're happy to look at anything else you'd like to show us while we're there.</p></div></article><article class="reveal"><div class="step-stage"><span class="step-number" aria-hidden="true">03</span><span class="step-art step-art-decide" role="img" aria-label="The homeowner considering an offer while the appraiser explains it"></span></div><div class="step-copy"><span class="step-kicker">STEP THREE</span><h3>The choice is yours.</h3><p>Hear your offer. Ask your questions. You decide. There's no fee and no obligation to sell.</p></div></article></div><p class="small duration-note">Timing varies with the number and type of items.</p></div></section>
<section class="value wrap section" aria-labelledby="value-title" data-folio="03"><span class="section-bridge" aria-hidden="true">VALUE, MADE CLEAR</span><div class="value-panel"><div class="value-copy"><p class="eyebrow">03 / UNDERSTANDING THE VALUE</p><h2 id="value-title">That box may hold<br><em>more than memories.</em></h2><p>What could your silver be worth?</p><div class="formula"><span>THE METAL-VALUE STARTING POINT</span><p>Today's silver price × weight × purity</p></div><p class="value-note">Popular patterns may be worth more than their melt value.</p><p class="fine">Actual offers depend on silver content, market prices and condition.</p></div><div class="value-image"><img src="/images/silver/silver-set.webp" alt="Illustrative sterling silver flatware collection" loading="lazy" width="1400" height="933"><span>THE BEAUTY IS IN THE DETAILS.</span></div></div></section>
<section class="benefits section wrap"><div><p class="eyebrow">04 / THE {company.brand} WAY</p><h2>A fair,<br>transparent<br><em>way to sell.</em></h2><p class="benefits-intro">Your silver has a story.<br>You deserve to know its value.</p></div><div class="benefit-list"><article><span>01</span><div><h3>Free &amp; no obligation</h3><p>A conversation costs nothing. Neither does saying no.</p></div></article><article><span>02</span><div><h3>Nothing behind closed doors</h3><p>We weigh and assess your silver in front of you, and explain how we arrive at your offer.</p></div></article><article><span>03</span><div><h3>We come to you</h3><p>No heavy boxes. No shipping. No unfamiliar counter.</p></div></article><article><span>04</span><div><h3>Your offer on the spot. Paid next day.</h3><p>We appraise your silver and tell you the amount at your home. If you agree to sell, we pay you by bank transfer by the end of the next day. <small class="pay-note">{paymentNote}</small></p></div></article></div></section>
<section id="people" class="people section" data-folio="05"><div class="wrap"><div class="section-top"><p class="eyebrow">05 / REAL PEOPLE, PERSONAL CARE</p><span class="small">A familiar face before the doorbell rings.</span></div><div class="people-heading"><h2>Meet the people<br>who'll visit you.</h2><p>We'll send your appraiser's name and photo before your visit. Family members are always welcome. And we never take items away for appraisal.</p></div><div class="appraiser-carousel"><div id="appraiser-list" class="appraisers" role="region" aria-label="Appraiser profiles. Use the arrow buttons or swipe horizontally to see all three on a small screen." tabindex="0"><article><div class="appraiser-photo profile-yosuke" role="img" aria-label="Portrait of Yosuke Matsuda"></div><h3>Yosuke Matsuda</h3><p>Silver specialist · Experience to be confirmed</p></article><article><div class="appraiser-photo profile-kota" role="img" aria-label="Portrait of Kota Onishi"></div><h3>Kota Onishi</h3><p>Silver specialist · Experience to be confirmed</p></article><article><div class="appraiser-photo profile-michael" role="img" aria-label="Portrait of Michael Turner"></div><h3>Michael Turner</h3><p>Silver specialist · Experience to be confirmed</p></article></div><button class="profile-arrow profile-arrow-prev" type="button" aria-label="Show previous appraiser" aria-controls="appraiser-list" hidden><span aria-hidden="true">←</span></button><button class="profile-arrow profile-arrow-next" type="button" aria-label="Show next appraiser" aria-controls="appraiser-list"><span aria-hidden="true">→</span></button></div><p class="profile-disclaimer">Profile experience details are pending confirmation.</p><div class="voices-heading"><h3>A few words from the kitchen table.</h3><span class="small">Sample customer stories for layout preview.</span></div><div class="voices"><article><p class="review-rating" aria-label="Five out of five stars"><span aria-hidden="true">★★★★★</span> <strong>5.0</strong></p><blockquote>“The appraisal was calm and straightforward. Every piece was weighed in front of me, and I never felt pressured.”</blockquote><p>L.M. · Plano, TX<span>Sterling flatware</span></p></article><article><p class="review-rating" aria-label="Five out of five stars"><span aria-hidden="true">★★★★★</span> <strong>5.0</strong></p><blockquote>“Having the visit at home made everything easier. The appraiser explained what was silver and what was plated.”</blockquote><p>D.R. · Austin, TX<span>Tea service</span></p></article><article><p class="review-rating" aria-label="Five out of five stars"><span aria-hidden="true">★★★★★</span> <strong>5.0</strong></p><blockquote>“I appreciated being able to ask questions and take my time before deciding.”</blockquote><p>C.B. · Houston, TX<span>Silver coins &amp; jewelry</span></p></article></div><p class="testimonial-disclaimer">Sample testimonial copy for layout preview. Replace with verified customer reviews before launch.</p></div></section>
<section class="comparison section wrap" data-folio="06"><p class="eyebrow">06 / A BETTER WAY</p><div class="section-top"><h2>How we compare.<br><em>We've laid it out honestly.</em></h2><p class="section-aside">It's your choice.<br>Here's what to consider.</p></div><div class="table-scroll" tabindex="0" role="region" aria-label="Service comparison, scroll horizontally on small screens"><table><thead><tr><th scope="col">What matters to you</th><th scope="col">{company.brand}<br><span>House call</span></th><th scope="col">Pawn shop</th><th scope="col">Mail-in buyer</th><th scope="col">Estate sale<br>company</th></tr></thead><tbody><tr><th scope="row">Where is it appraised?</th><td><span class="table-check" aria-hidden="true">✓</span><span class="cell-text">At your home</span></td><td>At the shop</td><td>At their facility</td><td>Usually at your home</td></tr><tr><th scope="row">Do you pack or carry anything?</th><td><span class="table-check" aria-hidden="true">✓</span><span class="cell-text">Nothing to pack or carry</span></td><td>You bring the items in</td><td>You pack and ship them</td><td>Usually not</td></tr><tr><th scope="row">When do you hear a price?</th><td><span class="table-check" aria-hidden="true">✓</span><span class="cell-text">At the visit, in front of you</span></td><td>Usually at the counter</td><td>After they receive and inspect your items</td><td>Items are priced for the sale; a buyout may be offered</td></tr><tr><th scope="row">When are you paid?</th><td><span class="table-check" aria-hidden="true">✓</span><span class="cell-text">By bank transfer, by the end of the next day</span></td><td>Typically at the counter</td><td>After you accept their offer; timing varies</td><td>After the sale, often a few weeks later</td></tr><tr><th scope="row">Can you say no?</th><td><span class="table-check" aria-hidden="true">✓</span><span class="cell-text">Yes. It's free, with no obligation</span></td><td>Yes. Check the terms if you pawn instead of sell</td><td>Check the terms first: deadlines and return rules vary</td><td>A contract sets the fees and terms</td></tr></tbody></table></div><p class="fine">How these options usually work, in general terms. Each provider's terms differ, so check the current terms before you decide. {company.brand} payment: {paymentNote} <Fragment set:html={rich('{{TODO: legal to confirm this comparison and its sources before launch}}')} /></p><div class="compare-view"><h3>Our view</h3><ul><li><strong>Pawn shop.</strong> A quick way to get cash when you can bring the items in. Offers vary from shop to shop, and a pawn loan, unlike a sale, comes with interest and a deadline to repay.</li><li><strong>Mail-in buyer.</strong> Can suit silver you don't mind shipping. Before you send anything, check the decision deadline, whether silence counts as acceptance, who pays return shipping and what the insurance covers.</li><li><strong>Estate sale company.</strong> Often the better choice when you are clearing a whole house. Many work on commission, and you are paid after the sale, not at the visit.</li><li><strong>{company.brand} house call.</strong> Best when you want to hear an offer for your silver and other valuables at home, without moving anything, and decide on the spot. If you are clearing a whole house item by item, an estate sale company may suit you better.</li></ul></div></section>
<section id="areas" class="areas section"><div class="wrap areas-grid"><div><p class="eyebrow">07 / RIGHT IN YOUR NEIGHBORHOOD</p><h2>Serving homes<br>across <em>Texas.</em></h2><p>Good service starts with showing up.</p><ZipCheck label="See if we come to your neighborhood" buttonClass="button button-cream" buttonSuffix="↗" /></div><div class="cities"><span class="cities-label">TEXAS, AT YOUR TABLE.</span><ul><li>Dallas–Fort Worth</li><li>Plano</li><li>Houston</li><li>The Woodlands</li></ul><p>Don't see your city? <a class="text-link" href={telHref} data-cta="mid" data-cta-method="phone">Give us a call ↗</a></p></div></div></section>
<section class="about section wrap"><p class="eyebrow">08 / A LITTLE ABOUT US</p><h2>25 years of in-home buying,<br><em>now in Texas.</em></h2><div class="about-bottom"><p>Respect for your home. Care for the things you've kept. An appraisal experience built around you, from the first hello to the final decision.</p><div><p>A company of BuySell Technologies Inc.</p><p class="small">Tokyo Stock Exchange listing · Code <Fragment set:html={rich('{{TODO: stock code}}')} /><br /><Fragment set:html={rich('{{TODO: number of}}')} /> employees</p><span class="fine">Company history and figures pending verification.</span></div></div></section>
<section id="questions" class="faq section wrap"><div class="faq-intro"><p class="eyebrow">09 / YOUR QUESTIONS, ANSWERED</p><h2>A little clarity,<br><em>before we visit.</em></h2><p>Still have something on your mind?</p><a class="text-link" href={telHref} data-cta="mid" data-cta-method="phone">We're happy to talk <span aria-hidden="true">↗</span></a></div><div class="faq-list">
        {
          silverFaq.map((item, index) => (
            <details open={index === 0} data-faq-id={item.id}>
              <summary>{item.q}</summary>
              <p set:html={rich(item.a)} />
              {item.note && <p class="pay-note">{item.note}</p>}
            </details>
          ))
        }
      </div></section>
<section class="final-cta section" data-final-cta><div class="wrap"><p class="eyebrow">A BOX OF SILVER. A WORLD OF POSSIBILITIES.</p><h2>Curious what it's worth?<br><em>Let's find out.</em></h2><p>Free to ask. No obligation to sell.</p><a class="final-phone" href={telHref} data-cta="final" data-cta-method="phone">{site.phone.callPrefix} <span data-phone-number>{site.phone.display}</span> <span aria-hidden="true">↗</span></a><p class="small" set:html={hoursLine} /><button class="text-link" type="button" data-booking data-cta="final" data-cta-method="form">Prefer to book online? <span aria-hidden="true">↗</span></button></div></section>
</main>

  <footer>
    <div class="wrap">
      <div class="footer-top">
        <a href="#" class="brand" aria-label={`${company.brand} home`}><BrandLogo class="brand-logo" variant="light" decorative /><span>SILVER SPECIALISTS · TEXAS</span></a>
        <p>Treasured possessions.<br /><em>A thoughtful next chapter.</em></p>
      </div>
      <div class="footer-info">
        <div>
          <p>{site.company.name}</p>
          <p>
            <Fragment set:html={rich(site.company.address)} /><br />{site.phone.display}
          </p>
        </div>
        <div>
          <p>{site.company.registration.label} <Fragment set:html={rich(site.company.registration.value)} /></p>
          <p>{site.regulator.label}<br /><Fragment set:html={rich(site.regulator.value)} /></p>
        </div>
        <div>
          <a href={site.links.privacy}>{site.ui.footer.privacy} ↗</a>
          <a href={site.links.terms}>{site.ui.footer.terms} ↗</a>
          <a href={site.links.doNotSell}>{site.ui.footer.doNotSell} ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {year} {site.company.name}. All rights reserved.</span>
        <span>A company of {company.group.name}</span>
      </div>
      {
        showPreviewStrip && (
          <p class="fine footer-preview">
            Design preview. Illustrative photography. Highlighted fields, service claims and legal information require
            confirmation before launch.
          </p>
        )
      }
    </div>
  </footer>

  <div class="mobile-bar" data-sticky-cta data-visible="false">
    <a href={telHref} data-cta="sticky" data-cta-method="phone">
      <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7.3 3.5 10 8 8.2 9.8a15 15 0 0 0 6 6l1.8-1.8 4.5 2.7-.7 3.1c-.2.8-.9 1.3-1.7 1.2C10.4 20.1 3.9 13.6 3 5.9c-.1-.8.4-1.5 1.2-1.7l3.1-.7Z"></path>
      </svg>
      <span class="cta-label">Call us</span><span aria-hidden="true">↗</span>
    </a>
    <button type="button" data-booking data-cta="sticky" data-cta-method="form">
      <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3v3M18 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 8h3v3H8v-3Z"></path>
      </svg>
      <span class="cta-label">Book a free appraisal</span><span aria-hidden="true">↗</span>
    </button>
  </div>

  <dialog id="booking-dialog" aria-labelledby="booking-title">
    <button class="dialog-close" type="button" aria-label="Close booking" data-close>×</button>
    <p class="eyebrow">AT YOUR HOME. AT YOUR PACE.</p>
    <h2 id="booking-title">Let's take a look.</h2>
    <p>Free appraisal. No obligation to sell.</p>
    <div id="consult" class="consult-panel">
      <ContactForm
        lp={silver.slug}
        company={plain(site.company.name)}
        buttonClass="button"
        submitLabel={silver.form.submitLabel}
        success={silver.form.success}
        afterSubmit={silver.form.afterSubmit}
        privacyUrl={site.links.privacy}
      />
    </div>
  </dialog>

  <script>
    import '../scripts/silver';
  </script>
</SilverLayout>

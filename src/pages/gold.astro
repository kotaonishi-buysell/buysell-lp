---
/*
 * Gold LP (/gold): "We come to your home to appraise your gold".
 * Markup and styling come from the designer's static page (Reworth_LP_金_案2_2026-11-01); see src/styles/gold.css for
 * what was changed on the way in. Copy shared with the LP machinery is in src/content/lps/gold.ts, company facts
 * in src/content/company.ts (through site.ts). Everything that is a call or a request goes through the shared pieces:
 *   - phone buttons are tel: links with data-cta (tracked by scripts/cta.ts)
 *   - "Get my free appraisal" buttons carry data-booking and scroll to the shared contact form (ContactForm)
 *   - the page's own behaviour (carousels, tabs, menu, desktop zoom, sticky bar) is in src/scripts/gold.ts
 * Left out of the designer's page until the facts are real: the two appraisers (sample photos, no names) and the
 * three sample reviews. See docs/design/gold/DESIGN_SYSTEM.md.
 */
import GoldLayout from '../layouts/GoldLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { gold, goldCopy } from '../content/lps/gold';
import { goldComparison } from '../content/lps/gold-comparison';
import { site } from '../content/site';
import { company } from '../content/company';
import { fill, plain, rich } from '../lib/text';

const telHref = `tel:${site.phone.e164}`;
const hoursLine = site.company.hours ? rich(fill(site.phone.hoursLine, { hours: site.company.hours })) : null;
const year = new Date().getFullYear();
const footerLinks = [
  { label: site.ui.footer.privacy, href: site.links.privacy },
  { label: site.ui.footer.terms, href: site.links.terms },
  { label: site.ui.footer.doNotSell, href: site.links.doNotSell },
];
---

<GoldLayout page={gold}>

<div class="ann">Free in-home appraisals in <b>Dallas–Fort Worth</b> and <b>Houston</b>*</div>
<header class="hd">
  <button class="hd-menu" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
  <a class="logo" href="#top" aria-label={company.brand}><BrandLogo decorative /></a>
  <nav class="hd-nav" aria-label="On this page"><a href="#how">How it works</a><a href="#items">What we buy</a><a href="#area">Areas</a><a href="#faq">FAQ</a></nav>
  <a class="hd-tel" href={telHref} data-cta="header" data-cta-method="phone" aria-label={`Call ${site.phone.display}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><span data-phone-number>{site.phone.display}</span></a>
  <a class="hd-cta" href="#consult" data-booking data-cta="header" data-cta-method="form">Free appraisal</a>
</header>
<nav class="drawer" id="drawer" hidden aria-label="Menu"><a href="#how">How it works</a><a href="#items">What we buy</a><a href="#area">Areas</a><a href="#faq">FAQ</a></nav>
<nav class="subnav" aria-label="On this page"><a href="#how">How it works</a><a href="#items">What we buy</a><a href="#area">Areas</a><a href="#faq">FAQ</a></nav>
<main id="main" class="page">
<section class="hero" id="top">
  <div class="hero-img"><img src="/images/gold/hero-gold.webp" srcset="/images/gold/hero-gold-780.webp 780w, /images/gold/hero-gold.webp 1080w" sizes="100vw" alt="An appraiser in white gloves looks at gold jewelry with a loupe at a customer's dining table" width="1080" height="650" fetchpriority="high"></div>
  <div class="hero-ov lp-callbox">
    <p class="eyebrow">Free in-home appraisal</p>
    <h1 class="h1">We come to <span class="ul">your home</span> to appraise your gold.</h1>
    <p class="hero-p">Free appraisal at your table, every piece appraised in front of you, no obligation to sell.</p>
    <a class="gbtn wh" href="#consult" data-booking data-cta="hero" data-cta-method="form"><span>Get my free appraisal</span></a>
    <a class="tel-w" href={telHref} data-cta="hero" data-cta-method="phone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><span>or call <span data-phone-number>{site.phone.display}</span></span></a>
    <p class="auth-w">{site.company.registration && <Fragment><b>{site.company.registration.label} <Fragment set:html={rich(site.company.registration.value)} /></b><i></i></Fragment>}<span>Part of {company.group.name} (Tokyo: 7685)</span></p>
  </div>
</section>
<section class="hero-sub">
  <ul class="pts"><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.3l3 3 6-6.5"/></svg><span><b>We come to your home</b> and appraise your gold on the spot</span></li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.3l3 3 6-6.5"/></svg><span><b>Every piece</b> appraised right there</span></li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.3l3 3 6-6.5"/></svg><span><b>Free appraisal</b>, no obligation to sell</span></li></ul>
  <p class="micro">Takes about a minute. We'll contact you to pick a day.</p>
</section>
<section class="sec how" id="how">
  <h2 class="h2">From your first message to <span class="ul">payment</span></h2>
  <div class="car steps" data-auto="3800" data-dots>
    <div class="car-vp" tabindex="0" aria-label="How it works, four steps"><article class="step"><figure><img src="/images/gold/S1.webp" alt="A woman talking on the phone at her kitchen table" width="760" height="570" style="object-position:50% 40%"></figure><div class="sb"><span class="num">01</span><h3 class="h3">First, tell us what you have</h3><p>Send the short form or call. Pick a day and tell us roughly what you have.</p></div></article><article class="step"><figure><img src="/images/gold/S2.webp" alt="A woman greets the appraiser at her front door" width="760" height="570" style="object-position:45% 35%"></figure><div class="sb"><span class="num">02</span><h3 class="h3">Then we come to your home</h3><p><Fragment set:html={rich(goldCopy.visitTiming)} /></p></div></article><article class="step"><figure><img src="/images/gold/S3.webp" alt="An appraiser weighs a piece on a small scale" width="760" height="570" style="object-position:55% 50%"></figure><div class="sb"><span class="num">03</span><h3 class="h3">We appraise at your table</h3><p>Gold, silver, watches, jewelry: everything is checked and appraised in front of you.</p></div></article><article class="step"><figure><img src="/images/gold/S4.webp" alt="The woman and the appraiser shake hands at the table" width="760" height="570" style="object-position:50% 40%"></figure><div class="sb"><span class="num">04</span><h3 class="h3">You choose what to sell</h3><p>{goldCopy.step4}</p></div></article></div>
    <div class="car-foot"><div class="dots" aria-hidden="true"></div><div class="car-nav"><button type="button" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button><button type="button" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button></div></div>
  </div>
  <div class="flowmov"><div class="fm">
<svg viewBox="0 0 340 168" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="color:#2E2E3A" role="img" aria-label="How a home appraisal works, in four steps">
<rect x="0" y="0" width="340" height="168" fill="#FBF7F0" stroke="none"/>
<path d="M18 146h304" stroke="#E2DCD2"/>
<g class="sc">
  <rect x="136" y="26" width="58" height="108" rx="7" fill="#fff"/>
  <path d="M158 34h14"/><rect x="144" y="48" width="42" height="9" stroke="#E2DCD2"/><rect x="144" y="63" width="42" height="9" stroke="#E2DCD2"/><rect x="144" y="78" width="42" height="9" stroke="#E2DCD2"/>
  <rect x="144" y="100" width="42" height="12" fill="#2E2E3A"/>
  <g class="wave"><path d="M206 58c6 6 6 18 0 24"/><path d="M216 50c10 10 10 30 0 40"/></g>
  <g class="wave"><path d="M124 58c-6 6-6 18 0 24"/><path d="M114 50c-10 10-10 30 0 40"/></g>
</g>
<g class="sc d1">
  <path d="M96 146V70l58-36 58 36v76"/><path d="M86 76l68-46 68 46"/>
  <rect x="140" y="96" width="30" height="50" fill="#FBF7F0"/>
  <rect class="door" x="140" y="96" width="30" height="50" fill="#fff"/>
  <rect x="110" y="88" width="18" height="18"/><rect x="182" y="88" width="18" height="18" fill="#C9A86A" fill-opacity=".3"/>
  <g class="walker"><circle cx="246" cy="98" r="7" fill="#fff"/><path d="M234 146v-28c0-6 5-10 12-10s12 4 12 10v28" fill="#2E2E3A" stroke="#2E2E3A"/><path d="M246 110l-3 10 3 4 3-4z" fill="#fff" stroke="none"/><rect x="258" y="122" width="12" height="16" fill="#fff"/></g>
</g>
<g class="sc d2">
  <path d="M40 132h260"/><path d="M60 132v14M280 132v14"/>
  <rect x="178" y="112" width="74" height="20" fill="#fff"/>
  <path d="M195 112a20 20 0 0 1 40 0" fill="#fff"/>
  <path class="needle" d="M215 112v-15" stroke="#C9A86A" stroke-width="2"/>
  <ellipse cx="120" cy="126" rx="15" ry="6" fill="#C9A86A" fill-opacity=".45"/><ellipse cx="120" cy="124" rx="9" ry="3"/>
  <g class="loupe"><circle cx="128" cy="96" r="15" fill="#fff" fill-opacity=".6"/><path d="M139 107l16 16" stroke-width="3"/></g>
</g>
<g class="sc d3">
  <g class="slip"><rect x="112" y="34" width="116" height="92" fill="#fff"/><path d="M126 52h56M126 64h40M126 104h88" stroke="#E2DCD2"/>
  <circle cx="200" cy="80" r="16" fill="#2E2E3A" stroke="#2E2E3A"/><path class="tick" d="M192 80l6 6 11-12" stroke="#fff" stroke-width="2.4"/></g>
</g>
</svg>
<div class="fm-cap"><p>First, tell us what you have</p><p class="d1">Then we come to your home</p><p class="d2">We appraise at your table</p><p class="d3">You choose what to sell</p></div>
<div class="fm-bar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
</div></div>
  <a class="gbtn" href="#consult" data-booking data-cta="mid" data-cta-method="form"><span>Get my free appraisal</span></a>
</section>
<section class="sec co">
  <figure class="co-photo"><img src="/images/gold/company-office.webp" alt="The BuySell Technologies sign at the company's office in Tokyo" width="800" height="600" loading="lazy"></figure>
  <div class="tcard"><p class="kick">Who we are</p><h2 class="h2">Backed by in-home buying in Japan</h2><p>We're part of {company.group.name} (Tokyo Stock Exchange: 7685).</p></div>
</section>
<section class="sec" id="items">
  <h2 class="h2">Have any of these <span class="ul">at home?</span></h2>
  <p class="lead c">Gold chains, rings, bracelets and earrings. Broken or single pieces too. Watches and silver as well.</p>
  <div class="mq" aria-label="Chains &amp; necklaces, Rings &amp; wedding bands, Earrings, Broken pieces, Bracelets, Watches, Sterling silver"><div class="mq-track" aria-hidden="true"><div class="mq-item"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9c0 18 8 27 18 27s18-9 18-27" stroke-dasharray="3.2 2.4"/><path d="M32 36v4"/><path d="M32 40l-4.5 6.5L32 54l4.5-7.5z" fill="#C9A86A" stroke="currentColor"/></svg><span>Chains &amp; necklaces</span></div><div class="mq-item"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="32" cy="40" rx="15" ry="12.5"/><ellipse cx="32" cy="40.5" rx="11" ry="8.8"/><path d="M27 25.5l5-6 5 6-5 4z" fill="#C9A86A" stroke="currentColor"/></svg><span>Rings &amp; wedding bands</span></div><div class="mq-item"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 16v6"/><circle cx="20" cy="33" r="10"/><path d="M44 16v6"/><circle cx="44" cy="33" r="10"/><circle cx="20" cy="16" r="1.8" fill="#C9A86A"/><circle cx="44" cy="16" r="1.8" fill="#C9A86A"/></svg><span>Earrings</span></div><div class="mq-item"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22c6 6 12 8 18 7" stroke-dasharray="3.2 2.4"/><path d="M36 38c6-2 12 1 18 7" stroke-dasharray="3.2 2.4"/><path d="M28 29l3 3M33 35l-2-3"/><ellipse cx="22" cy="48" rx="7" ry="4.5" transform="rotate(-18 22 48)"/><circle cx="46" cy="18" r="2.4" fill="#C9A86A"/></svg><span>Broken pieces</span></div><div class="mq-item"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="32" cy="34" rx="20" ry="12"/><ellipse cx="32" cy="34" rx="16" ry="8.5"/><path d="M14 30l3 1M20 24.5l2 2.5M28 22.5l.8 3M36 22.5l-.8 3M44 24.5l-2 2.5M50 30l-3 1"/></svg><span>Bracelets</span></div><div class="mq-item"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M25 8h14l-2 12H27zM27 44h10l2 12H25z"/><circle cx="32" cy="32" r="12"/><path d="M32 25v7l4.5 3"/><path d="M44.5 30.5h2.5"/></svg><span>Watches</span></div><div class="mq-item"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8v14M17 8v9a4 4 0 0 0 8 0V8M21 26v30"/><ellipse cx="42" cy="17" rx="6.5" ry="9"/><path d="M42 26v30"/></svg><span>Sterling silver</span></div><div class="mq-item dup"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9c0 18 8 27 18 27s18-9 18-27" stroke-dasharray="3.2 2.4"/><path d="M32 36v4"/><path d="M32 40l-4.5 6.5L32 54l4.5-7.5z" fill="#C9A86A" stroke="currentColor"/></svg><span>Chains &amp; necklaces</span></div><div class="mq-item dup"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="32" cy="40" rx="15" ry="12.5"/><ellipse cx="32" cy="40.5" rx="11" ry="8.8"/><path d="M27 25.5l5-6 5 6-5 4z" fill="#C9A86A" stroke="currentColor"/></svg><span>Rings &amp; wedding bands</span></div><div class="mq-item dup"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 16v6"/><circle cx="20" cy="33" r="10"/><path d="M44 16v6"/><circle cx="44" cy="33" r="10"/><circle cx="20" cy="16" r="1.8" fill="#C9A86A"/><circle cx="44" cy="16" r="1.8" fill="#C9A86A"/></svg><span>Earrings</span></div><div class="mq-item dup"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22c6 6 12 8 18 7" stroke-dasharray="3.2 2.4"/><path d="M36 38c6-2 12 1 18 7" stroke-dasharray="3.2 2.4"/><path d="M28 29l3 3M33 35l-2-3"/><ellipse cx="22" cy="48" rx="7" ry="4.5" transform="rotate(-18 22 48)"/><circle cx="46" cy="18" r="2.4" fill="#C9A86A"/></svg><span>Broken pieces</span></div><div class="mq-item dup"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="32" cy="34" rx="20" ry="12"/><ellipse cx="32" cy="34" rx="16" ry="8.5"/><path d="M14 30l3 1M20 24.5l2 2.5M28 22.5l.8 3M36 22.5l-.8 3M44 24.5l-2 2.5M50 30l-3 1"/></svg><span>Bracelets</span></div><div class="mq-item dup"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M25 8h14l-2 12H27zM27 44h10l2 12H25z"/><circle cx="32" cy="32" r="12"/><path d="M32 25v7l4.5 3"/><path d="M44.5 30.5h2.5"/></svg><span>Watches</span></div><div class="mq-item dup"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8v14M17 8v9a4 4 0 0 0 8 0V8M21 26v30"/><ellipse cx="42" cy="17" rx="6.5" ry="9"/><path d="M42 26v30"/></svg><span>Sterling silver</span></div></div></div>
</section>
<section class="sec cards-sec">
  <div class="car" data-auto="4200">
    <div class="car-vp" tabindex="0" aria-label="What we appraise"><article class="card"><figure><img src="/images/gold/G1.webp" alt="Gold chains, necklaces and a bracelet" width="720" height="720"></figure><div class="cb"><p class="lb">Chains &amp; necklaces</p><p class="nm">Chains, necklaces &amp; bracelets</p><p class="sm">Even if tangled or broken</p></div></article><article class="card"><figure><img src="/images/gold/G2.webp" alt="Gold wedding bands, a class ring and a signet ring" width="720" height="720"></figure><div class="cb"><p class="lb">Rings</p><p class="nm">Rings &amp; wedding bands</p></div></article><article class="card"><figure><img src="/images/gold/G3.webp" alt="Gold hoop and stud earrings, some without a pair" width="720" height="720"></figure><div class="cb"><p class="lb">Earrings</p><p class="nm">Earrings, even single ones</p></div></article><article class="card"><figure><img src="/images/gold/G4.webp" alt="A broken gold chain, a bent ring and other broken gold" width="720" height="720"></figure><div class="cb"><p class="lb">Broken pieces</p><p class="nm">Broken &amp; unwanted pieces</p></div></article><article class="card"><figure><img src="/images/gold/G5.webp" alt="The 14K stamp inside a gold band" width="720" height="720"></figure><div class="cb"><p class="nm">Is it gold?</p><p class="sm">Look for 10K, 14K, 18K, 585 or 750 inside the band or on the clasp. No mark? We'll check it.</p></div></article><article class="card"><figure><img src="/images/gold/P5.webp" alt="Three pre-owned wristwatches" width="720" height="720"></figure><div class="cb"><p class="nm">Watches</p></div><span class=tag>In the same visit, we appraise these too</span></article><article class="card"><figure><img src="/images/gold/P1.webp" alt="Sterling silver forks, knives and spoons" width="720" height="720"></figure><div class="cb"><p class="nm">Sterling silver</p></div><span class=tag>In the same visit, we appraise these too</span></article></div>
    <div class="car-nav"><button type="button" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button><button type="button" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button></div>
  </div>
  <p class="note">Broken chains and single earrings count too. Set them all out.</p>
  <p class="note small">Not sure about something? Set it out. We'll tell you what we can buy.</p>
  <a class="gbtn" href="#consult" data-booking data-cta="mid" data-cta-method="form"><span>Get my free appraisal</span></a>
</section>
{goldComparison.enabled && <section class="sec" id="cmp">
  <h2 class="h2">What changes when we <span class="ul">come to you</span></h2>
  <div class="tabs seg" role="tablist" aria-label="Compare"><button type="button" role="tab" id="t-shop" aria-controls="p-shop" aria-selected="true"><span class="tl"><BrandLogo /></span><span class="vs">vs.</span><span class="tn">pawn or gold shop</span></button><button type="button" role="tab" id="t-mail" aria-controls="p-mail" aria-selected="false" tabindex="-1"><span class="tl"><BrandLogo /></span><span class="vs">vs.</span><span class="tn">mail-in buyer</span></button></div>
  <div class="panel" id="p-shop" role="tabpanel" aria-labelledby="t-shop"><table class="cmp2"><thead><tr><td></td><th scope="col" class="them">Pawn or gold shop</th><th scope="col" class="us"><span class="cmp-logo"><BrandLogo /></span></th></tr></thead><tbody><tr><th scope="row">We come to your home</th><td class="them"><svg class="ix" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg><span class="vh">No</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">An appraiser in a suit and white gloves</th><td class="them"><span class="some">Varies</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">Every piece appraised in front of you</th><td class="them"><span class="some">Varies</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">No trip, even if you decide not to sell</th><td class="them"><svg class="ix" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg><span class="vh">No</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">Gold, silver, watches and jewelry in one visit</th><td class="them"><span class="some">Varies</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr></tbody></table></div><div class="panel" id="p-mail" role="tabpanel" aria-labelledby="t-mail" hidden><table class="cmp2"><thead><tr><td></td><th scope="col" class="them">Mail-in buyer</th><th scope="col" class="us"><span class="cmp-logo"><BrandLogo /></span></th></tr></thead><tbody><tr><th scope="row">No packing or shipping</th><td class="them"><svg class="ix" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg><span class="vh">No</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">Appraised in front of you</th><td class="them"><svg class="ix" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg><span class="vh">No</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">Paid by bank transfer</th><td class="them"><span class="some">Varies</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">Your items stay home unless you sell</th><td class="them"><svg class="ix" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg><span class="vh">No</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr><tr><th scope="row">Gold, silver, watches and jewelry in one visit</th><td class="them"><span class="some">Varies</span></td><td class="us"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="vh">Yes</span></td></tr></tbody></table></div>
  <p class="cmp-note">The left column describes a typical experience, not any particular business.</p>
</section>}
<section class="sec promise-sec">
  <h2 class="h2">No cost, no obligation <span class="ul">to sell</span></h2>
  <p class="lead c">Four things that are always true when we visit.</p>
  <div class="pro-grid"><div class="pro"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22L24 9l16 13"/><path d="M12 19v20h24V19"/><path d="M20 39V28h8v11"/><path d="M30 14v-4h4v7"/></svg><p>There's no charge for the visit or the appraisal.</p></div><div class="pro"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="30" height="30" rx="2"/><path d="M17 24.5l5 5 10-11"/></svg><p>You decide what to sell, if anything.</p></div><div class="pro"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="17" cy="16" r="5"/><circle cx="32" cy="18" r="4"/><path d="M8 38c0-7 4-11 9-11s9 4 9 11"/><path d="M27 38c0-5.5 2.3-8.5 5.5-8.5S40 32.5 40 38"/></svg><p>Family is welcome to sit in.</p></div><div class="pro"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h18v32H14z"/><circle cx="27.5" cy="24" r="1.4" fill="currentColor"/><path d="M36 24h8M41 20l3 4-3 4"/></svg><p>Don't want to sell? We simply leave.</p></div></div>
  <a class="gbtn" href="#consult" data-booking data-cta="mid" data-cta-method="form"><span>Get my free appraisal</span></a>
</section>
<section class="sec" id="area">
  <h2 class="h2">We visit homes in Dallas–Fort Worth and <span class="ul">Houston</span></h2>
  <div class="areas">
    <div class="acard g"><p class="kick">Now visiting</p><p class="an">Dallas–Fort Worth</p><p>Home visits in selected cities now.*</p><div class="mapbox"><svg class="map" viewBox="0 0 320 110" fill="none" stroke="#FFFFFF" stroke-opacity=".35" stroke-width="1.2" aria-hidden="true">
<path d="M0 30h320M0 70h320M60 0v110M150 0v110M240 0v110M0 100L120 0M170 110L320 18"/>
<path d="M30 0c20 40 70 60 130 70s100 30 140 40" stroke-width="3" stroke-opacity=".5"/>
<circle class="pin-pulse" cx="168" cy="58" r="8" fill="#C9A86A" fill-opacity=".5" stroke="none"/>
<path d="M168 66s-11-9.5-11-17.5a11 11 0 0 1 22 0c0 8-11 17.5-11 17.5z" fill="#C9A86A" stroke="#2E2E3A" stroke-opacity="1" stroke-width="1.4"/>
<circle cx="168" cy="48.5" r="3.6" fill="#2E2E3A" stroke="none"/>
</svg><p class="zipchip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span>Send us your ZIP code</span></p></div></div>
    <div class="acard g"><p class="kick">Now visiting</p><p class="an">Houston</p><p>Home visits in selected cities now.*</p><div class="mapbox"><svg class="map" viewBox="0 0 320 110" fill="none" stroke="#FFFFFF" stroke-opacity=".35" stroke-width="1.2" aria-hidden="true">
<path d="M0 30h320M0 70h320M60 0v110M150 0v110M240 0v110M0 100L120 0M170 110L320 18"/>
<path d="M30 0c20 40 70 60 130 70s100 30 140 40" stroke-width="3" stroke-opacity=".5"/>
<circle class="pin-pulse" cx="168" cy="58" r="8" fill="#C9A86A" fill-opacity=".5" stroke="none"/>
<path d="M168 66s-11-9.5-11-17.5a11 11 0 0 1 22 0c0 8-11 17.5-11 17.5z" fill="#C9A86A" stroke="#2E2E3A" stroke-opacity="1" stroke-width="1.4"/>
<circle cx="168" cy="48.5" r="3.6" fill="#2E2E3A" stroke="none"/>
</svg><p class="zipchip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span>Send us your ZIP code</span></p></div></div>
  </div>
  <p class="zip">*Not every city in the Dallas–Fort Worth and Houston areas is covered yet. Send us your ZIP code and we'll tell you if we can come.</p>
  <p class="small office">Office: <Fragment set:html={rich(site.company.address)} />{site.company.hours && <Fragment>, <Fragment set:html={rich(site.company.hours)} /></Fragment>}.</p>
</section>
<section class="sec faq" id="faq">
  <h2 class="h2">Questions people ask</h2>
  <details class="qa" open data-faq-id="how-to-book"><summary><span class="q">How do I book?</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary><div class="a"><p>Fill out the short form or call us. We'll ask your ZIP code and what you have, then pick a day.</p></div></details><details class="qa" data-faq-id="how-paid"><summary><span class="q">If I decide to sell, what happens next?</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary><div class="a"><p>{goldCopy.payment}</p></div></details><details class="qa" data-faq-id="id-needed"><summary><span class="q">Do I need an ID?</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary><div class="a"><p>If you sell, yes. Texas law requires us to check a photo ID.</p></div></details>
</section>
<section class="final" id="book">
  <h2 class="h2">Find out what your gold is worth.</h2>
  <p class="fin-p">It costs nothing to ask.</p>
  <div class="callrow"><a class="tel big" href={telHref} data-cta="final" data-cta-method="phone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><span>or call <span data-phone-number>{site.phone.display}</span></span></a>{hoursLine && <p class="small" set:html={hoursLine} />}</div>
  <div class="consult-panel" id="consult">
    <h3 class="consult-h">Or send us a request online</h3>
    <ContactForm
      lp={gold.slug}
      company={plain(site.company.name)}
      buttonClass="gbtn"
      submitLabel={gold.form.submitLabel}
      success={gold.form.success}
      afterSubmit={gold.form.afterSubmit}
      privacyUrl={site.links.privacy}
    />
  </div>
</section>
<footer class="foot">
  <div class="logo"><BrandLogo variant="light" /></div>
  <p><b>{site.company.name}</b><br /><Fragment set:html={rich(site.company.address)} /><br />{site.phone.display}<br /><a href={`mailto:${site.company.email}`}>{site.company.email}</a></p>
  {site.company.registration && <p>{site.company.registration.label} <Fragment set:html={rich(site.company.registration.value)} /></p>}
  <p>{company.brand} is operated by {site.company.name}, part of {company.group.name} (Tokyo Stock Exchange: 7685).</p>
  {site.regulator && <p>{site.regulator.label}<br /><Fragment set:html={rich(site.regulator.value)} /></p>}
  <p>{footerLinks.map((link, i) => <Fragment>{i > 0 && <Fragment>&emsp;</Fragment>}<a href={link.href}>{link.label}</a></Fragment>)}</p>
  <p>Images are for illustration.</p>
</footer>
<div class="foot-bar">© {year} {site.company.name}</div>
</main>
<div class="sticky"><a class="gbtn" href="#consult" data-booking data-cta="sticky" data-cta-method="form"><span>Get my free appraisal</span></a><a class="st-tel" href={telHref} data-cta="sticky" data-cta-method="phone" aria-label={`Call ${site.phone.display}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></a></div>

<script>
  import '../scripts/gold';
</script>
</GoldLayout>

---
/* "Page not found". Netlify serves dist/404.html for any address that does not exist (for example the LPs that are still drafts). */
import LegalLayout from '../layouts/LegalLayout.astro';
---

<LegalLayout slug="404" title="Page not found" description="This page does not exist." noindex>
  <article class="lg-article">
    <h1>Page not found</h1>
    <p>We couldn't find the page you were looking for.</p>
    <p><a href="/">Go to the home page</a></p>
  </article>
</LegalLayout>

---
/*
 * Appraisal LP (/appraisal): "Not using it. Not tossing it. Just give us a call."
 * Same skeleton and motion as the Silver LP (src/pages/silver.astro, src/scripts/silver.ts), with its own stylesheet
 * (src/styles/appraisal.css). Copy that is shared with the LP machinery (meta, form, FAQ, categories) is in
 * src/content/lps/appraisal.ts and src/content/site.ts. Everything that is a call or a request goes through the shared pieces:
 *   - phone buttons are tel: links with data-cta (tracked by scripts/cta.ts)
 *   - booking buttons carry data-booking and open the shared contact form (ContactForm) in the dialog
 *   - the service-area ZIP box is the shared ZipCheck
 * Left out until they are approved, as on Silver: customer testimonials and the competitor comparison (no sections here).
 */
import AppraisalLayout from '../layouts/AppraisalLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import ZipCheck from '../components/ZipCheck.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { appraisal, appraisalCategories, appraisalFaq } from '../content/lps/appraisal';
import { site } from '../content/site';
import { company } from '../content/company';
import { paymentNote } from '../content/payment-note';
import { fill, plain, rich } from '../lib/text';

const telHref = `tel:${site.phone.e164}`;
const hoursLine = site.company.hours ? rich(fill(site.phone.hoursLine, { hours: site.company.hours })) : null;
const year = new Date().getFullYear();
---

<AppraisalLayout page={appraisal}>
  <header class="header wrap">
<a class="brand" href="#" aria-label={`${company.brand} home`}><BrandLogo class="brand-logo" decorative /><span>HOUSE-CALL APPRAISALS · TEXAS</span></a>
<nav class="desktop-nav" aria-label="Main navigation"><a href="#items">What we buy</a><a href="#how">How it works</a><a href="#questions">Your questions</a></nav>
<div class="header-contact">{hoursLine && <p class="call-hours" set:html={hoursLine} />}<a class="phone-text" href={telHref} data-cta="header" data-cta-method="phone">{site.phone.callPrefix} <span data-phone-number>{site.phone.display}</span></a><div>{site.company.registration && <span>{site.company.registration.label} <Fragment set:html={rich(site.company.registration.value)} /></span>}<button class="text-link" type="button" data-booking data-cta="header" data-cta-method="form">Book online</button></div></div>
</header>
<div class="compact-bar" data-compact-bar inert>
<a class="compact-brand" href="#" aria-label={`${company.brand} home`}><BrandLogo class="brand-logo" decorative /></a>
<nav aria-label="Quick navigation"><a href="#items">What we buy</a><a href="#how">How it works</a><a href="#questions">Your questions</a></nav>
<div class="compact-contact"><a class="phone-text" href={telHref} data-cta="header" data-cta-method="phone">{site.phone.callPrefix} <span data-phone-number>{site.phone.display}</span></a><button class="text-link" type="button" data-booking data-cta="header" data-cta-method="form">Book online</button></div>
</div>
<main id="main">
<section class="hero wrap" aria-labelledby="hero-title" data-hero>
<div class="hero-copy"><p class="eyebrow"><span class="short-rule"></span> TOO NICE TO TOSS.</p><h1 id="hero-title"><span>Not using it. Not <span class="glint">tossing</span> it.</span><em>Just give us a call.</em></h1><h2 class="hero-sub">Free in-home appraisals for the things<br class="desktop-only"> that have been sitting around the house.</h2><div class="hero-actions"><a class="button" href={telHref} data-cta="hero" data-cta-method="phone">{site.phone.callPrefix} <span data-phone-number>{site.phone.display}</span></a><button class="text-link" type="button" data-booking data-cta="hero" data-cta-method="form">Book online</button></div><ul class="hero-chips"><li>Free appraisal</li><li>No obligation</li><li>One call to start</li><li>We come to you</li></ul></div>
<figure class="hero-photo"><img src="/images/silver/hero-appraisal.webp" alt="Two appraisers in dark suits and white gloves, each examining an item through a jeweler's loupe in a bright home" width="1400" height="1050" fetchpriority="high"><figcaption><span>GOOD THINGS DESERVE A NEXT CHAPTER.</span><span class="photo-caption">An appraisal, at your pace.</span></figcaption></figure>
</section>
{site.company.registration && <section class="trust wrap" aria-label="Service assurances"><div><span class="trust-label">A little peace of mind.</span><p>Registered with the Texas OCCC<br><small>Reg. No. <Fragment set:html={rich(site.company.registration.value)} /></small></p></div></section>}
<section id="items" class="buy-section section wrap" data-folio="01">
<div class="section-top"><p class="eyebrow">01 / THE THINGS YOU'VE KEPT</p><p class="section-aside">The watch in the drawer.<br>The bag you stopped carrying.</p></div>
<div class="category-heading"><h2>What can you sell?</h2><p>Accessories, designer goods, watches and more.<br>One item or a whole drawerful.</p></div>
<div class="category-carousel" role="region" aria-roledescription="carousel" aria-label="What we buy">
<div class="category-viewport" tabindex="0" aria-label="Explore eight categories. Swipe or use the arrow keys to scroll.">
<div class="category-track"><ul class="category-group">
{appraisalCategories.map((category) => (
<li class="category-item"><span class="category-image" role="img" aria-label={category.alt}><svg viewBox="0 0 48 48" aria-hidden="true" set:html={category.icon}></svg></span><h3 set:html={category.label}></h3></li>
))}
</ul></div></div>
<div class="category-controls"><p>Any condition. Not sure it qualifies? That's okay.</p><button class="category-motion" type="button" aria-label="Pause automatic scrolling"><span class="motion-symbol" aria-hidden="true">Ⅱ</span><span class="motion-label">Pause</span></button></div>
</div>
<aside class="polish"><span class="serif">A small favor:</span><div><strong>Please don't clean or polish anything.</strong><p>We look at your things just as they are.</p></div><span class="polish-star" aria-hidden="true">✳</span></aside>
</section>
<section id="how" class="how section" data-folio="02"><div class="wrap"><div class="section-top"><p class="eyebrow">02 / SIMPLE, FROM START TO FINISH</p><button class="text-link" type="button" data-booking data-cta="mid" data-cta-method="form">Find a time that suits you</button></div><h2>How a house call works.</h2><div class="steps"><article class="reveal"><div class="step-stage"><span class="step-number" aria-hidden="true">01</span><span class="step-art step-art-book" role="img" aria-label="A homeowner comfortably arranging a visit by phone"></span></div><div class="step-copy"><span class="step-kicker">STEP ONE</span><h3>Make one call.</h3><p>Call or book online. Pick a time that suits you. Leave everything exactly where it is.</p></div></article><article class="reveal"><div class="step-stage"><span class="step-number" aria-hidden="true">02</span><span class="step-art step-art-appraise" role="img" aria-label="An appraiser examining items with the homeowner at the kitchen table"></span></div><div class="step-copy"><span class="step-kicker">STEP TWO</span><h3>We'll look at it all.</h3><p>We appraise at your home, right in front of you. Watches, jewelry, bags, cameras, whatever you've kept, all in the same visit.</p></div></article><article class="reveal"><div class="step-stage"><span class="step-number" aria-hidden="true">03</span><span class="step-art step-art-decide" role="img" aria-label="The homeowner considering an offer while the appraiser explains it"></span></div><div class="step-copy"><span class="step-kicker">STEP THREE</span><h3>The choice is yours.</h3><p>Hear your offer. Ask your questions. You decide. There's no fee and no obligation to sell.</p></div></article></div><p class="small duration-note">Timing varies with the number and type of items.</p></div></section>
<section class="value wrap section" aria-labelledby="value-title" data-folio="03"><span class="section-bridge" aria-hidden="true">VALUE, MADE CLEAR</span><div class="value-panel"><div class="value-copy"><p class="eyebrow">03 / UNDERSTANDING THE VALUE</p><h2 id="value-title">That drawer may hold<br><em>more than memories.</em></h2><p>What could your things be worth?</p><div class="formula"><span>WHAT WE LOOK AT</span><p>The item · its materials · its condition</p></div><p class="value-note">Original boxes and papers, if you still have them, are worth setting out too.</p><p class="fine">Actual offers depend on the item, market prices and condition.</p></div><div class="value-image"><img src="/images/silver/house-call.webp" alt="Illustrative: an appraiser examining a collection with a homeowner at a kitchen table" loading="lazy" width="1400" height="933"><span>THE BEAUTY IS IN THE DETAILS.</span></div></div></section>
<section class="benefits section wrap"><div><p class="eyebrow">04 / THE {company.brand} WAY</p><h2>A fair,<br>transparent<br><em>way to sell.</em></h2><p class="benefits-intro">Your things have a story.<br>You deserve to know their value.</p></div><div class="benefit-list"><article><span>01</span><div><h3>Free &amp; no obligation</h3><p>A conversation costs nothing. Neither does saying no.</p></div></article><article><span>02</span><div><h3>Nothing behind closed doors</h3><p>We look at your items in front of you, and explain how we arrive at your offer.</p></div></article><article><span>03</span><div><h3>We come to you</h3><p>No heavy boxes. No shipping. No unfamiliar counter. Everything gets looked at in one visit.</p></div></article><article><span>04</span><div><h3>Your offer at the visit. Paid next day.</h3><p>We appraise your items and tell you the amount at your home. If you agree to sell, we pay you by bank transfer by the end of the next day. <small class="pay-note">{paymentNote}</small></p></div></article></div></section>
<section id="people" class="people section" data-folio="05"><div class="wrap"><div class="section-top"><p class="eyebrow">05 / REAL PEOPLE, PERSONAL CARE</p><span class="small">A familiar face before the doorbell rings.</span></div><div class="people-heading"><h2>Meet the people<br>who'll visit you.</h2><p>We'll send your appraiser's name and photo before your visit. Family members are always welcome. And we never take items away for appraisal.</p></div><div class="appraiser-carousel"><div id="appraiser-list" class="appraisers" role="region" aria-label="Appraiser profiles. Use the arrow buttons or swipe horizontally to see every profile on a small screen." tabindex="0"><article><div class="appraiser-photo profile-yosuke" role="img" aria-label="Portrait of Yosuke Matsuda"></div><h3>Yosuke Matsuda</h3><p>5 years of experience</p></article><article><div class="appraiser-photo profile-koki" role="img" aria-label="Portrait of Koki Iguchi"></div><h3>Koki Iguchi</h3><p>4 years of experience</p></article></div><button class="profile-arrow profile-arrow-prev" type="button" aria-label="Show previous appraiser" aria-controls="appraiser-list" hidden><span aria-hidden="true">←</span></button><button class="profile-arrow profile-arrow-next" type="button" aria-label="Show next appraiser" aria-controls="appraiser-list"><span aria-hidden="true">→</span></button></div></div></section>
<section id="areas" class="areas section"><div class="wrap areas-grid"><div><p class="eyebrow">06 / RIGHT IN YOUR NEIGHBORHOOD</p><h2>Serving homes<br>across <em>Texas.</em></h2><p>Good service starts with showing up.</p><ZipCheck label="See if we come to your neighborhood" buttonClass="button button-cream" /></div><div class="cities"><span class="cities-label">TEXAS, AT YOUR TABLE.</span><ul><li>Dallas–Fort Worth</li><li>Plano</li><li>Houston</li><li>The Woodlands</li></ul><p>Don't see your city? <a class="text-link" href={telHref} data-cta="mid" data-cta-method="phone">Give us a call</a></p></div></div></section>
<section class="about section wrap"><p class="eyebrow">07 / A LITTLE ABOUT US</p><h2>In-home buying,<br><em>now in Texas.</em></h2><div class="about-bottom"><p>Respect for your home. Care for the things you've kept. An appraisal experience built around you, from the first hello to the final decision.</p><div><p>A company of {company.group.name}</p><p class="small">Listed on the Tokyo Stock Exchange (Growth Market) · Code 7685</p></div></div></section>
<section id="questions" class="faq section wrap"><div class="faq-intro"><p class="eyebrow">08 / YOUR QUESTIONS, ANSWERED</p><h2>A little clarity,<br><em>before we visit.</em></h2><p>Still have something on your mind?</p><a class="text-link" href={telHref} data-cta="mid" data-cta-method="phone">We're happy to talk</a></div><div class="faq-list">
        {
          appraisalFaq.map((item, index) => (
            <details open={index === 0} data-faq-id={item.id}>
              <summary>{item.q}</summary>
              <p set:html={rich(item.a)} />
              {item.note && <p class="pay-note">{item.note}</p>}
            </details>
          ))
        }
      </div></section>
<section class="final-cta section" data-final-cta><div class="wrap"><p class="eyebrow">TOO NICE TO TOSS. WORTH A LOOK.</p><h2>Pick up the phone.<br><em>We'll take it from there.</em></h2><p>Free to ask. No obligation to sell.</p><a class="final-phone" href={telHref} data-cta="final" data-cta-method="phone">{site.phone.callPrefix} <span data-phone-number>{site.phone.display}</span></a>{hoursLine && <p class="small" set:html={hoursLine} />}<button class="text-link" type="button" data-booking data-cta="final" data-cta-method="form">Prefer to book online?</button></div></section>
</main>

  <footer>
    <div class="wrap">
      <div class="footer-top">
        <a href="#" class="brand" aria-label={`${company.brand} home`}><BrandLogo class="brand-logo" variant="light" decorative /><span>HOUSE-CALL APPRAISALS · TEXAS</span></a>
        <p>Treasured possessions.<br /><em>A thoughtful next chapter.</em></p>
      </div>
      <div class="footer-info">
        <div>
          <p>{site.company.name}</p>
          <p>
            <Fragment set:html={rich(site.company.address)} /><br />{site.phone.display}<br /><a href={`mailto:${site.company.email}`}>{site.company.email}</a>
          </p>
        </div>
        {
          (site.company.registration || site.regulator) && (
            <div>
              {site.company.registration && <p>{site.company.registration.label} <Fragment set:html={rich(site.company.registration.value)} /></p>}
              {site.regulator && <p>{site.regulator.label}<br /><Fragment set:html={rich(site.regulator.value)} /></p>}
            </div>
          )
        }
        <div>
          <a href={site.links.privacy}>{site.ui.footer.privacy}</a>
          <a href={site.links.terms}>{site.ui.footer.terms}</a>
          <a href={site.links.doNotSell}>{site.ui.footer.doNotSell}</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {year} {site.company.name}. All rights reserved.</span>
        <span>A company of {company.group.name}</span>
      </div>
      <p class="fine footer-note">Illustrative photography.</p>
    </div>
  </footer>

  <div class="mobile-bar" data-sticky-cta data-visible="false">
    <a href={telHref} data-cta="sticky" data-cta-method="phone">
      <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7.3 3.5 10 8 8.2 9.8a15 15 0 0 0 6 6l1.8-1.8 4.5 2.7-.7 3.1c-.2.8-.9 1.3-1.7 1.2C10.4 20.1 3.9 13.6 3 5.9c-.1-.8.4-1.5 1.2-1.7l3.1-.7Z"></path>
      </svg>
      <span class="cta-label">Call us</span>
    </a>
    <button type="button" data-booking data-cta="sticky" data-cta-method="form">
      <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3v3M18 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm3 8h3v3H8v-3Z"></path>
      </svg>
      <span class="cta-label">Book a free appraisal</span>
    </button>
  </div>

  <dialog id="booking-dialog" aria-labelledby="booking-title">
    <button class="dialog-close" type="button" aria-label="Close booking" data-close>×</button>
    <p class="eyebrow">AT YOUR HOME. AT YOUR PACE.</p>
    <h2 id="booking-title">Let's take a look.</h2>
    <p>Free appraisal. No obligation to sell.</p>
    <div id="consult" class="consult-panel">
      <ContactForm
        lp={appraisal.slug}
        company={plain(site.company.name)}
        buttonClass="button"
        submitLabel={appraisal.form.submitLabel}
        success={appraisal.form.success}
        afterSubmit={appraisal.form.afterSubmit}
        privacyUrl={site.links.privacy}
      />
    </div>
  </dialog>

  <script>
    import '../scripts/silver';
  </script>
</AppraisalLayout>

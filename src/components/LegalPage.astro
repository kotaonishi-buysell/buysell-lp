---
/* Renders one of the shared legal pages from src/content/legal.ts. */
import { site } from '../content/site';
import { legalCopy, type LegalPageContent } from '../content/legal';
import { fill, plain, rich } from '../lib/text';
import LegalLayout from '../layouts/LegalLayout.astro';
import PrivacyChoice from './PrivacyChoice.astro';

interface Props {
  page: LegalPageContent;
}

const { page } = Astro.props;

// {company}, {address} ... come from site.ts. The OCCC registration and notice are '' until they are
// confirmed: a block that then prints nothing (and a section left empty) is dropped, never shown as a TODO.
const tokens = {
  company: plain(site.company.name),
  brand: site.brand.name,
  address: site.company.address,
  phone: site.phone.display,
  // Hours are printed only when the company publishes them (company.showHours); then " (hours)" follows the phone.
  hoursSuffix: site.company.hours ? ` (${site.company.hours})` : '',
  email: site.legal.privacyEmail,
  effective: site.legal.effectiveDate,
  registration: site.company.registration ? `${site.company.registration.label}: ${site.company.registration.value}` : '',
  regulator: site.regulator ? `${site.regulator.label}: ${site.regulator.value}` : '',
};
// A real email address becomes a mailto link; a TODO placeholder stays text.
const emailLink = tokens.email.includes('{{') ? null : tokens.email;
const html = (text: string) => {
  const out = rich(fill(text, tokens));
  return emailLink ? out.replaceAll(emailLink, `<a href="mailto:${emailLink}">${emailLink}</a>`) : out;
};
const description = fill(page.description, { company: tokens.company, brand: tokens.brand });
const sections = page.sections
  .map((section) => ({
    ...section,
    blocks: section.blocks.filter((block) => typeof block !== 'string' || fill(block, tokens).trim() !== ''),
  }))
  .filter((section) => section.blocks.length > 0);
---

<LegalLayout slug={page.slug} title={page.title} description={description}>
  <article class="lg-article">
    <h1>{page.title}</h1>
    <p class="lg-meta" set:html={html(legalCopy.effective)} />
    <p class="lg-intro" set:html={html(page.intro)} />

    <nav class="lg-toc" aria-labelledby="toc-title">
      <h2 id="toc-title">{legalCopy.contents}</h2>
      <ol>
        {sections.map((section) => <li><a href={`#${section.id}`}>{section.heading}</a></li>)}
      </ol>
    </nav>

    {
      sections.map((section) => (
        <section id={section.id} aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}>{section.heading}</h2>
          {section.blocks.map((block) =>
            typeof block === 'string' ? (
              <p set:html={html(block)} />
            ) : 'list' in block ? (
              <ul>{block.list.map((item) => <li set:html={html(item)} />)}</ul>
            ) : (
              <PrivacyChoice />
            ),
          )}
        </section>
      ))
    }
    <p class="lg-top"><a href="#main">{legalCopy.back}</a></p>
  </article>
</LegalLayout>

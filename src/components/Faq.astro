---
import type { FaqItem } from '../content/types';
import { rich } from '../lib/text';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item, index) => (
      <details class="faq__item" open={index === 0} data-faq-id={item.id}>
        <summary class="faq__question">
          <span class="t-heading">{item.q}</span>
        </summary>
        <p class="faq__answer muted" set:html={rich(item.a)} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    max-width: calc(var(--measure) + var(--space-13));
    padding-inline: var(--space-3);
    background: var(--paper-raised);
    border-radius: var(--radius-md);
  }

  .faq__item + .faq__item {
    border-top: var(--hairline) solid var(--line-strong);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: '+';
    content: '+' / '';
    flex: none;
    color: var(--pine);
    font-family: var(--font-sans);
    font-size: var(--fs-heading);
    line-height: var(--lh-heading);
    font-weight: var(--weight-regular);
  }

  .faq__item[open] > .faq__question::after {
    content: '\2013';
    content: '\2013' / '';
  }

  .faq__answer {
    max-width: var(--measure);
    padding-bottom: var(--space-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--motion-fast) ease,
        content-visibility var(--motion-fast) allow-discrete;
    }

    .faq__item[open]::details-content {
      height: auto;
    }
  }
</style>

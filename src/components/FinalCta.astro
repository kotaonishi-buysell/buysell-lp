---
import type { FinalSection, LandingPage } from '../content/types';
import CtaGroup from './CtaGroup.astro';
import ConsultForm from './ConsultForm.astro';

interface Props {
  section: FinalSection;
  lp: LandingPage;
}

const { section, lp } = Astro.props;
const headingId = `${section.id}-title`;
const formHeadingId = 'consult-title';
---

<section id={section.id} class="final scene section" aria-labelledby={headingId} data-final-cta>
  <div class="container final__inner">
    <div class="final__intro">
      <h2 id={headingId} class="t-display-l">{section.headline}</h2>
      <p class="t-lead">{section.body}</p>
      <CtaGroup location="final" label={lp.cta.label} reassurance={section.reassurance} align="center" />
    </div>

    <div id="consult" class="final__panel on-paper">
      <h3 id={formHeadingId} class="t-heading final__form-heading">{section.formHeading}</h3>
      <ConsultForm lp={lp} />
    </div>
  </div>
</section>

<style>
  .final__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .final__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    max-width: var(--measure);
    text-align: center;
  }

  .final__intro .t-lead {
    margin-bottom: var(--space-2);
  }

  .final__panel {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--space-5));
    padding: var(--space-5) var(--space-3);
    background: var(--paper);
    border-radius: var(--radius-md);
    scroll-margin-top: var(--space-3);
  }

  .final__form-heading {
    margin-bottom: var(--space-3);
  }

  @media (min-width: 720px) {
    .final__panel {
      padding: var(--space-5);
    }
  }
</style>

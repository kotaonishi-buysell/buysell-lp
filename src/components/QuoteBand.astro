---
interface Props {
  id: string;
  text: string;
}

const { id, text } = Astro.props;
---

<section id={id} class="quote scene section">
  <div class="container">
    <p class="t-display-l quote__text">{text}</p>
  </div>
</section>

<style>
  .quote__text {
    max-width: var(--measure);
    margin-inline: auto;
    text-align: center;
  }
</style>

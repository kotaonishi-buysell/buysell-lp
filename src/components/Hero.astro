---
import type { HeroSection, LandingPage } from '../content/types';
import { rich } from '../lib/text';
import CtaGroup from './CtaGroup.astro';

interface Props {
  section: HeroSection;
  lp: LandingPage;
}

const { section, lp } = Astro.props;
const headingId = `${section.id}-title`;
---

<section id={section.id} class="hero scene" aria-labelledby={headingId} data-hero>
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="t-label muted">{section.eyebrow}</p>
      <h1 id={headingId} class="t-display-xl">{section.headline}</h1>
      <p class="t-lead hero__lead">{section.lead}</p>
      <div class="hero__cta">
        <CtaGroup
          location="hero"
          label={lp.cta.label}
          reassurance={section.reassurance}
          secondary={{ label: lp.cta.bookingLabel, href: '#consult', booking: true }}
        />
      </div>
    </div>
    <div class="hero__media">
      {
        section.image ? (
          <img
            class="hero__image"
            src={section.image.src}
            width={section.image.width}
            height={section.image.height}
            alt={section.imageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero__image hero__placeholder" role="img" aria-label={section.imageAlt}>
            <p class="t-meta" set:html={rich(section.imagePlaceholder)} />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5) var(--section-pad);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hero__lead {
    max-width: var(--measure);
  }

  .hero__cta {
    margin-top: var(--space-2);
  }

  .hero__image {
    width: 100%;
    aspect-ratio: var(--hero-image-ratio);
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .hero__placeholder {
    display: flex;
    align-items: flex-end;
    padding: var(--space-3);
    background: var(--paper-raised);
    border: var(--hairline) solid var(--line);
    color: var(--ink-muted);
  }

  @media (max-width: 1023.98px) {
    .hero__media {
      max-width: var(--measure);
    }

    .hero__image {
      aspect-ratio: var(--hero-image-ratio-stacked);
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
      align-items: center;
      gap: var(--space-8);
      padding-block: var(--space-8) var(--section-pad);
    }
  }
</style>

---
import type { SectionHeaderContent } from '../content/types';

interface Props {
  header: SectionHeaderContent;
  headingId: string;
  align?: 'start' | 'center';
}

const { header, headingId, align = 'start' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]}>
  <p class="t-label muted">{header.eyebrow}</p>
  <h2 id={headingId} class="t-display-l">{header.headline}</h2>
  {header.lead && <p class="t-lead muted section-header__lead">{header.lead}</p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }

  .section-header--center {
    align-items: center;
    text-align: center;
  }

  .section-header h2 {
    max-width: var(--measure);
  }

  .section-header__lead {
    max-width: var(--measure);
    margin-top: var(--space-1);
  }
</style>
